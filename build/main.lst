  50:Core/Src/main.c **** int usleep(useconds_t usec) {
  51:Core/Src/main.c ****     if (usec < 1000) {
  52:Core/Src/main.c ****         // Đối với delay cực nhỏ, dùng vòng lặp nop thay vì vTaskDelay
  53:Core/Src/main.c ****         for (volatile uint32_t i = 0; i < (usec * 20); i++) { __NOP(); }
  54:Core/Src/main.c ****     } else {
  55:Core/Src/main.c ****         vTaskDelay(pdMS_TO_TICKS(usec / 1000));
  56:Core/Src/main.c ****     }
  57:Core/Src/main.c ****     return 0;
  58:Core/Src/main.c **** }
  59:Core/Src/main.c **** int _gettimeofday(struct timeval *tv, void *tzvp) {
  60:Core/Src/main.c ****     if (tv) {
  61:Core/Src/main.c ****         TickType_t ticks = xTaskGetTickCount();
  62:Core/Src/main.c ****         tv->tv_sec  = ticks / configTICK_RATE_HZ;
  63:Core/Src/main.c ****         tv->tv_usec = (ticks % configTICK_RATE_HZ) * (1000000 / configTICK_RATE_HZ);
  64:Core/Src/main.c ****     }
  65:Core/Src/main.c ****     return 0;
  66:Core/Src/main.c **** }
  67:Core/Src/main.c **** /* USER CODE END PD */
